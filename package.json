{
  "name": "opencode-smart-ui",
  "version": "0.1.0",
  "description": "ChatGPT-style smart chat UI for opencode: the model can render charts, dashboards, tables, progress, callouts, menus, quizzes and next-prompt suggestions directly in the conversation.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "smart-ui",
    "charts",
    "tui"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist/index.js --external:@opencode-ai/plugin --external:zod",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "preview": "node dev/preview.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.14.46",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
